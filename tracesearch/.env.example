# Copy to .env. Never commit your .env file.
# Values are literal strings (optional matching quotes); no variable expansion.
TRACE_DB_HOST=127.0.0.1
TRACE_DB_PORT=3306
TRACE_DB_USER=tracesearch_app
TRACE_DB_PASSWORD=replace-with-your-local-database-password
TRACE_DB_NAME=tracesearch
TRACE_WORKSPACE=.tracesearch
TRACE_MODEL=sentence-transformers/all-MiniLM-L6-v2
# A concrete Hugging Face commit is required for reproducible model identity.
TRACE_MODEL_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
TRACE_OFFLINE=false
TRACE_CHUNK_TOKENS=180
TRACE_OVERLAP_TOKENS=30
TRACE_BATCH_SIZE=32
TRACE_MAX_FILE_MIB=50
TRACE_MAX_CHUNKS=50000
